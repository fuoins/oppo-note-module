<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：读取便签版本、拉起便签 -->
    <queries>
        <package android:name="com.coloros.note" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 无 LAUNCHER 入口：模块不在桌面显示图标，设置从便签「设置」进入 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/module_settings_title" />

        <activity
            android:name=".ui.BatchFormatActivity"
            android:exported="true"
            android:label="@string/batch_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:label="@string/log_title" />

        <!-- 宿主进程读取模块配置的通道 -->
        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.fuoins.opponote.config"
            android:exported="true" />

        <!-- Xposed / LSPosed 模块声明（传统 API 82，兼容所有 LSPosed 版本） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
