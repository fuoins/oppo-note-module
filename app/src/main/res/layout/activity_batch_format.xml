<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 字段 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style.SectionTitle"
            android:text="@string/section_fields" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/field_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_field_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/field_empty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Button
                    android:id="@+id/btn_add_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style.MiniButton"
                    android:text="@string/add_date_field" />

                <Button
                    android:id="@+id/btn_add_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style.MiniButton"
                    android:text="@string/add_text_field" />
            </LinearLayout>
        </LinearLayout>

        <!-- 日历设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style.SectionTitle"
            android:text="@string/section_date" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/et_pattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pattern_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/preset_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pattern_help"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/rg_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_daily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/interval_daily"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_every"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/interval_every_n"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_weekly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/interval_weekly"
                    android:textSize="13sp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_interval_days"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/interval_days_hint"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/sp_weekday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/count_hint"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 排版 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SectionTitle"
            android:text="@string/section_layout" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <RadioGroup
                android:id="@+id/rg_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_space"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/layout_space"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_newline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_newline"
                    android:textSize="14sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/et_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/space_count_hint"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_blank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/blank_lines_hint"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/sw_align"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="@string/align_columns"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 预览 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style.SectionTitle"
            android:text="@string/section_preview" />

        <EditText
            android:id="@+id/et_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="3dp"
            android:minHeight="140dp"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_header"
            android:text="@string/btn_generate"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/MiniButton"
                android:text="@string/btn_copy" />

            <Button
                android:id="@+id/btn_clean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/MiniButton"
                android:text="@string/btn_clean" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
